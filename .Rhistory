acc_count  <- 0L
## initialize
eta <- log(pmax(y, 1e-6))  # avoid 0
beta0 <- 0
beta1 <- 0
s2    <- 1
## MH, so that sigma approx 0.447
metrop_var<-0.20
## log full-conditional for eta_i
logpost_eta_i <- function(eta_i, y_i, mu_i, s2){
-exp(eta_i) + y_i * eta_i - ( (eta_i - mu_i)^2 )/(2*s2)
}
set.seed(567)
for (t in 1:n_iter) {
## Update each eta_i via MH
mu_vec <- beta0 + beta1 * x       # mean under N(mu, s2)
for (i in 1:n) {
eta_old <- eta[i]
eta_new <- rnorm(1, mean = eta_old, sd = sqrt(metrop_var))
lp_old <- logpost_eta_i(eta_old, y[i], mu_vec[i], s2)
lp_new <- logpost_eta_i(eta_new, y[i], mu_vec[i], s2)
ratio <- exp(lp_new - lp_old)
if (ratio >= runif(n=1,min=0,max=1)) {
eta[i] <- eta_new
acc_count <- acc_count + 1L
}
}
S_eta   <- sum(eta)
S_x     <- sum(x)
S_x2    <- sum(x^2)
S_xeta  <- sum(x * eta)
## Update beta0 | beta1, eta, s2
A0 <- n/s2 + prior_prec_beta
V0 <- 1 / A0
m0 <- V0 * ( (S_eta - beta1 * S_x) / s2 )
beta0 <- rnorm(1, mean = m0, sd = sqrt(V0))
## Update beta1 | beta0, eta, s2
A1 <- S_x2/s2 + prior_prec_beta
V1 <- 1 / A1
m1 <- V1 * ( (S_xeta - beta0 * S_x) / s2 )
beta1 <- rnorm(1, mean = m1, sd = sqrt(V1))
## Update sigma^2 | beta, eta  (inverse-gamma)
resid <- eta - (beta0 + beta1 * x)
a_post <- a0 + n/2
b_post <- b0 + 0.5 * sum(resid^2)
s2 <- 1 / rgamma(1, shape = a_post, rate = b_post)  # IG via 1/Gamma
## save
beta_keep[t, ] <- c(beta0, beta1)
s2_keep[t]     <- s2
eta_keep[t, ]  <- eta
}
## Posterior summaries (exclude eta)
idx <- seq(burn + 1, n_iter, by = thin)
#idx <- seq(burn + 1, n_iter)
post_beta0 <- beta_keep[idx, 1]
post_beta1 <- beta_keep[idx, 2]
post_s2    <- s2_keep[idx]
etci95 <- function(z) quantile(z, c(0.025, 0.975), names = FALSE)
summ <- rbind(
beta0 = c(mean(post_beta0), sd(post_beta0), etci95(post_beta0)),
beta1 = c(mean(post_beta1), sd(post_beta1), etci95(post_beta1)),
sigma2= c(mean(post_s2),   sd(post_s2),   etci95(post_s2))
)
colnames(summ) <- c("Post.Mean","Post.SD","CI2.5%","CI97.5%")
print(round(summ, 4))
library(coda)
## post-burn-in draws
#post_idx   <- (burn + 1):n_iter
#post_beta0 <- beta_keep[post_idx, 1]
#post_beta1 <- beta_keep[post_idx, 2]
#post_s2    <- s2_keep[post_idx]
idx <- seq(burn + 1, n_iter, by = thin)
post_beta0 <- beta_keep[idx, 1]
post_beta1 <- beta_keep[idx, 2]
post_s2    <- s2_keep[idx]
mcmc_obj   <- mcmc(cbind(beta0 = post_beta0,
beta1 = post_beta1,
sigma2 = post_s2))
## Trace plots
par(mfrow = c(3,1), mar = c(3,3,2,1))
plot(post_beta0, type = "l", xlab = "Iteration (post burn-in)",
ylab = "beta0", main = "Trace: beta0")
plot(post_beta1, type = "l", xlab = "Iteration (post burn-in)",
ylab = "beta1", main = "Trace: beta1")
plot(post_s2, type = "l", xlab = "Iteration (post burn-in)",
ylab = expression(sigma^2), main = "Trace: sigma^2")
## Autocorrelation Function (ACF) plots
op <- par(mfrow = c(1,3), mar = c(3,3,2,1))
acf(post_beta0, main = "ACF: beta0")
acf(post_beta1, main = "ACF: beta1")
acf(post_s2,    main = "ACF: sigma2")
par(op)
## Effective Sample Size (ESS)
ess <- effectiveSize(mcmc_obj)
cat("\nEffective Sample Size (ESS):\n")
print(round(ess, 1))
## Geweke diagnostic (z-scores)
gw <- geweke.diag(mcmc_obj, frac1 = 0.1, frac2 = 0.5)
cat("\nGeweke z-scores:\n")
print(round(gw$z, 3))
